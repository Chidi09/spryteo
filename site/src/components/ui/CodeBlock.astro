---
interface Props { html?: string; code?: string; }
const { html, code } = Astro.props as Props;
---

{html && <div class="code-block" set:html={html} />}
{code && <pre class="code-block code-block-plain">{code}</pre>}

<style>
  .code-block {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 16px 18px;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.7;
    overflow-x: auto;
    margin: 0 0 44px;
  }
  .code-block-plain {
    color: var(--text);
    white-space: pre;
  }
</style>
