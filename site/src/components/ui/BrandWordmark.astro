---
import Logo from './Logo.astro';

interface Props {
  size?: number;
  fontSize?: string;
}

const { fontSize = '18px' } = Astro.props;
---

<div class="wordmark" style={`font-size: ${fontSize};`}>
  <Logo />
  <span>spryteo</span>
</div>

<style>
  .wordmark {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    text-decoration: none;
  }
</style>
