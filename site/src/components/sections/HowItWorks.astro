---
import Icon from '../ui/Icon.astro';
import { pipelineSteps as steps } from '../../lib/content';
---

<section class="section">
  <h2 class="title">How it works</h2>
  <p class="subtitle">Five deterministic steps, from pixels to a path you can animate.</p>
  <div class="grid">
    {steps.map((s) => (
      <div class="card">
        <div class="card-n">{s.n}</div>
        <div class="card-title">{s.title}</div>
        <div class="card-desc">{s.desc}</div>
      </div>
    ))}
  </div>
  <a href="/docs#options" class="section-docs-link">every option, tuned per surface <Icon name="arrow-right" size={14} /></a>
</section>

<style>
  .section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 64px 32px;
  }
  .title {
    font-size: 32px;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 0 0 6px;
  }
  .subtitle {
    font-size: 16px;
    color: var(--muted);
    margin: 0 0 34px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
  }
  .section-docs-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 24px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
  }
  .section-docs-link:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 20px;
  }
  .card-n {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    margin-bottom: 12px;
  }
  .card-title {
    font-size: 15px;
    font-weight: 500;
    margin-bottom: 6px;
  }
  .card-desc {
    font-size: 13px;
    line-height: 1.5;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 560px) {
    .section {
      padding: 40px 20px;
    }
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
