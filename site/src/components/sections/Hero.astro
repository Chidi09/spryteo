---
import ClippedButton from '../ui/ClippedButton.astro';
---

<section class="hero">
  <div aria-hidden="true" class="hero-bg">
    <img id="heroGif" src="/assets/hero-1.gif" alt="" class="hero-gif" />
  </div>
  <div class="hero-content">
    <div class="hero-badge sc-stagger">v1.0 &#8212; free &amp; open source</div>
    <h1 class="hero-title sc-stagger">Raster in. Animateable SVG out.</h1>
    <p class="hero-subtitle sc-stagger">Traced, grouped, and ready to animate &#8212; entirely offline.</p>
    <div class="hero-typing sc-stagger">
      <span class="install-prompt">$</span>
      <span>spryteo convert </span><span id="heroTyping" class="hero-typing-text"></span><span class="hero-caret">&#8203;</span>
    </div>
    <div class="hero-actions sc-stagger">
      <ClippedButton id="ctaHero" variant="primary">convert an icon</ClippedButton>
      <ClippedButton id="heroDocs" variant="secondary">read the docs</ClippedButton>
    </div>
    <div class="hero-install sc-stagger">
      <span class="install-prompt">$</span>
      <span>npm install spryteo</span>
      <button id="copyInstall" class="install-copy">copy</button>
    </div>
  </div>
  <div class="demo-frame sc-stagger">
    <div class="demo-header">
      <span class="demo-live"><span class="live-dot"></span>live demo</span>
      <span>trace &#8594; group &#8594; animate</span>
    </div>
    <div id="demoArea" class="demo-area" role="button" tabindex="0" aria-label="Drop an image to convert, or click to browse">
      <input id="fileInput" class="demo-file-input" type="file" accept="image/png,image/jpeg,image/svg+xml,image/gif,image/webp" hidden />
      <div id="demoContent" class="demo-idle">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#A3A199" stroke-width="1.4">
          <path d="M12 16V4M12 4L7 9M12 4l5 5" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3" stroke-linecap="round" />
        </svg>
        <span class="demo-idle-text">drop a .png, .jpg, .svg or .gif &#8212; or click to browse</span>
      </div>
    </div>
    <div class="demo-footer">
      <span id="demoCaption" class="demo-caption">icon.png &#8594; icon.svg &#183; 1 path &#183; 3 groups</span>
      <button id="runDemo" class="demo-btn">run again</button>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    max-width: 1200px;
    margin: 0 auto;
    padding: 72px 32px 40px;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, var(--bg) 0%, var(--bg) 10%, transparent 56%);
  }
  .hero-gif {
    position: absolute;
    right: -4%;
    top: 50%;
    transform: translateY(-50%);
    height: 118%;
    max-width: none;
    opacity: 0.42;
    filter: invert(1) grayscale(1) contrast(1.15);
    mix-blend-mode: screen;
    transition: opacity 400ms ease;
  }
  .hero-content {
    position: relative;
    z-index: 1;
  }
  .sc-stagger {
    animation: sc-rise 640ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .hero-badge.sc-stagger { animation-delay: 0ms; }
  .hero-title.sc-stagger { animation-delay: 70ms; }
  .hero-subtitle.sc-stagger { animation-delay: 140ms; }
  .hero-actions.sc-stagger { animation-delay: 210ms; }
  .hero-install.sc-stagger { animation-delay: 260ms; }
  .demo-frame.sc-stagger { animation-delay: 180ms; }
  .hero-badge {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
    letter-spacing: 0.02em;
    margin-bottom: 22px;
  }
  .hero-title {
    font-size: 60px;
    line-height: 1.03;
    letter-spacing: -0.03em;
    font-weight: 500;
    margin: 0 0 22px;
    text-wrap: balance;
  }
  .hero-subtitle {
    font-size: 18px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 520px;
    margin: 0 0 20px;
    text-wrap: pretty;
  }
  .hero-typing {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 9px 14px;
    margin: 0 0 26px;
  }
  .hero-typing-text {
    color: var(--accent);
    white-space: pre;
  }
  .hero-caret {
    display: inline-block;
    width: 7px;
    height: 15px;
    background: var(--accent);
    margin-left: 2px;
    animation: sc-flicker 900ms steps(2, jump-none) infinite;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 26px;
    flex-wrap: wrap;
  }
  .hero-install {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 11px 14px;
    font-family: var(--font-mono);
    font-size: 14px;
  }
  .install-prompt {
    color: var(--muted);
  }
  .install-copy {
    cursor: pointer;
    border: 0;
    background: transparent;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 2px 6px;
    transition: color var(--transition-fast);
  }
  .install-copy:hover {
    color: var(--accent);
  }

  .demo-frame {
    position: relative;
    z-index: 1;
    background: var(--surface);
    border: 1px solid var(--border);
    clip-path: polygon(26px 0, 100% 0, 100% 100%, 0 100%, 0 26px);
    padding: 26px;
    min-height: 360px;
    display: flex;
    flex-direction: column;
    transition: border-color 300ms ease, filter 300ms ease;
    filter: drop-shadow(0 0 0 transparent);
  }
  .demo-frame:hover {
    border-color: rgba(198, 255, 75, 0.35);
    filter: drop-shadow(0 18px 40px rgba(198, 255, 75, 0.16));
  }
  .demo-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 18px;
  }
  .demo-live {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .live-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 6px var(--accent);
    animation: sc-pulse-dot 1.8s ease-in-out infinite;
  }
  .demo-area {
    flex: 1;
    border: 1px dashed var(--border);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding: 26px;
    cursor: pointer;
    transition: border-color var(--transition-fast);
  }
  .demo-area:hover {
    border-color: var(--accent);
  }
  .demo-area.dragover {
    border-style: solid;
    border-color: var(--accent);
    background: rgba(198, 255, 75, 0.05);
  }
  .demo-area.demo-error {
    border-style: solid;
    border-color: #ff5f56;
  }
  .demo-error-text {
    color: #ff5f56;
  }
  .demo-idle {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    color: var(--muted);
  }
  .demo-idle-text {
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .demo-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 16px;
  }
  .demo-caption {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
  .demo-btn {
    cursor: pointer;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text);
    border-radius: var(--radius-sm);
    font-size: 12px;
    padding: 6px 12px;
    transition: border-color var(--transition-fast);
  }
  .demo-btn:hover {
    border-color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .sc-stagger {
      animation: none;
    }
    .live-dot {
      animation: none;
    }
    .hero-caret {
      animation: none;
    }
  }

  @media (max-width: 980px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 48px 24px 32px;
    }
    .hero-title {
      font-size: 42px;
    }
    .hero-gif {
      opacity: 0.22;
    }
    .demo-frame {
      min-height: 300px;
    }
  }

  @media (max-width: 560px) {
    .hero {
      padding: 36px 18px 28px;
    }
    .hero-title {
      font-size: 32px;
    }
    .hero-subtitle {
      font-size: 16px;
    }
    .hero-typing {
      font-size: 12px;
      padding: 8px 10px;
      max-width: 100%;
      overflow-x: auto;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-install {
      flex-wrap: wrap;
    }
    .demo-frame {
      padding: 18px;
      min-height: 260px;
    }
  }
</style>
