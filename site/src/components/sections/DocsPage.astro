---
import CodeBlock from '../ui/CodeBlock.astro';
import Icon from '../ui/Icon.astro';

const surfaces = [
  { id: 'cli', tag: 'terminal', title: 'CLI', desc: 'One binary. Point it at a file, get an SVG back.' },
  { id: 'library', tag: 'node · npm', title: 'Library', desc: 'Native addon (napi-rs). Same engine, no subprocess.' },
  { id: 'browser', tag: 'wasm', title: 'Browser', desc: 'Runs client-side. No upload, no server round-trip.' },
  { id: 'mcp', tag: 'agents', title: 'MCP server', desc: 'Two tools agents can call mid-conversation.' },
];

const modes = [
  { name: 'auto', desc: 'Picks a profile from the image itself — dimensions, unique-colour count, edge hardness, ink ratio. Every heuristic is overridable with --mode.' },
  { name: 'icon', desc: 'Few unique colours (≤32 after a 1% noise floor) or a flat-fill alpha channel. Aggressive primitive recognition — circles and rects come out as <circle>/<rect>, not path soup.' },
  { name: 'pixel-art', desc: '≤128px, ≤64 unique colours, hard-edged (no anti-aliasing). Traces exact pixel boundaries with corner-preserving fit instead of smoothing them away.' },
  { name: 'line-art', desc: 'Ink drawings binarize into exactly two layers — paper and ink — using a global Otsu threshold for solid strokes plus a capped Sauvola local threshold that rescues faint thin lines. A duotone validation gate falls back to full colour quantization when the image isn\'t genuinely two-tone. Pairs with --stroke for centerline output.' },
  { name: 'photo', desc: 'Everything else. K-means colour quantization, optional gradient detection, bilateral filtering + JPEG deblocking, and automatic downscaling above 1600px so a 4K photo doesn\'t blow the time budget.' },
];

const cliFlags: [string, string][] = [
  ['-o, --output <path>', 'Output SVG path. Required.'],
  ['--mode <auto|icon|pixel-art|line-art|photo>', 'Override input classification. Default: auto.'],
  ['--stroke', 'Run the centerline tracer instead of fill-mode outlining.'],
  ['--css <draw|fade|pop>', 'Bake one of the built-in CSS animation presets into the SVG.'],
  ['--colors <n>', 'Target palette size for quantization — a ceiling, not a guarantee: visually indistinguishable clusters are merged after quantization.'],
  ['--layering <stacked|cutout>', 'Photo-mode layer composition.'],
  ['--gradients <auto|on|off>', 'Gradient-fill detection. auto only tries it in photo mode.'],
  ['--tolerance <px>', 'Curve-fit error budget, in pixels. Lower = more path points.'],
  ['--smoothness <n>', 'Corner-preservation strength for the Bezier fit.'],
  ['--turdsize <px²>', 'Discard regions smaller than this area (noise suppression).'],
  ['--precision <n>', 'Decimal places in emitted path coordinates.'],
  ['--pretty', 'Pretty-print the SVG instead of minifying it.'],
  ['--jsx', 'Emit a React JSX component instead of plain SVG.'],
  ['--current-color', 'Monochrome output inherits colour via currentColor.'],
  ['--background <keep|drop|rect>', 'Background treatment: keep as a layer, drop it, or emit as <rect>.'],
  ['--alpha-mode <keep|matte:#rrggbb|threshold:0-255>', 'Alpha handling: preserve, matte against a colour, or hard-cut at threshold.'],
  ['--grouping <component|semantic|flat>', 'Grouping strategy: connected component, ML mask-guided, or no grouping.'],
  ['--id-style <hash|sequential|none>', 'ID generation: content-derived hash, sequential counter, or omit.'],
  ['--transform-origin <centroid|baked>', 'Transform origin placement — centroid offset or baked into coordinates.'],
  ['--arcs', 'Emit circular-arc path commands where detected (off by default).'],
  ['--max-trace-dimension <n>', 'Downscale inputs larger than this dimension before tracing.'],
  ['--max-pixels <n>', 'Maximum pixel count accepted (decompression-bomb guard).'],
  ['--max-input-bytes <n>', 'Maximum input file size in bytes.'],
  ['--timeout-ms <n>', 'Abort conversion after this many milliseconds.'],
  ['--json <path>', 'Write the metadata sidecar (nodes, bboxes, groups, stats) as JSON.'],
];

const crates: [string, string][] = [
  ['spryteo-core', 'Shared IR types, ConvertOptions, pipeline orchestration, errors'],
  ['spryteo-raster', 'Decode (PNG/JPEG/GIF/WebP/BMP), EXIF orientation, ICC→sRGB, downscale, preprocess'],
  ['spryteo-quant', 'Input classification, colour quantization, line-art binarization, background detection'],
  ['spryteo-trace', 'Contour extraction (Suzuki-Abe, marching squares), hole hierarchy'],
  ['spryteo-fit', 'Polygon simplification, corner detection, straight-run recovery, Bezier curve fitting'],
  ['spryteo-geom', 'Primitive recognition (circle, ellipse, rect, arc), geometry hashing'],
  ['spryteo-stroke', 'Centerline tracing: binarization, skeletonization, Eulerian path traversal'],
  ['spryteo-semantic', 'Mask-overlap grouping heuristics for externally-supplied segmentation masks'],
  ['spryteo-svg', 'Scene graph construction, SVG emission, metadata sidecar'],
  ['spryteo-cli', 'CLI binary (clap), pipeline wiring, error reporting'],
  ['spryteo-mcp', 'MCP server exposing convert_image and inspect_svg as agent tools'],
  ['spryteo-api', 'HTTP API stub (axum), planned not yet shipped'],
];

const pipelineStages = [
  { name: 'decode', desc: 'PNG/JPEG/GIF/WebP/BMP → raw RGBA. EXIF orientation applied, embedded ICC profiles converted to sRGB via a pure-Rust colour stack (no LGPL dependency).' },
  { name: 'classify', desc: 'Picks auto\'s mode: dimensions, unique-colour count (with a 1% noise floor), edge hardness, and ink ratio decide icon vs. pixel-art vs. line-art vs. photo.' },
  { name: 'downscale', desc: 'Inputs above --max-trace-dimension (1600px default trigger, 1024px working size) are resampled with Lanczos3 before tracing; output coordinates still land on the original viewBox.' },
  { name: 'preprocess', desc: 'Mode-specific cleanup: bilateral filtering and JPEG-deblocking for photos, Otsu + capped Sauvola local thresholding with a Lab-space duotone validation gate for line-art.' },
  { name: 'quantize', desc: 'K-means colour reduction to the target palette (seeded, deterministic — kmeans++ with a fixed seed) or the line-art binarizer\'s two-layer paper/ink split.' },
  { name: 'apply_background_policy', desc: 'Decides whether the base layer is kept, dropped, or flattened into a <rect> per --background.' },
  { name: 'extract_contours', desc: 'Suzuki-Abe border following over a marching-squares field builds a parent/child hole hierarchy per connected region — a letter "O" becomes one path with a true hole subpath, not two overlapping fills.' },
  { name: 'fit_contours', desc: 'Simplifies each contour, detects corners, then fits Bezier segments — with a chord-straightness pre-check that emits a plain LineTo (and merges consecutive collinear runs) instead of curve-fitting edges that are already straight.' },
  { name: 'build_fills', desc: 'Resolves fill colours/gradients per shape and promotes near-circular or near-rectangular contours to real <circle>/<ellipse>/<rect> primitives instead of path soup.' },
  { name: 'build_scene_graph', desc: 'Groups shapes into a <g> tree (containment-order by default, or mask-guided) and assigns stable content-derived or sequential IDs.' },
  { name: 'emit_svg', desc: 'Serializes the scene graph — minified or --pretty, JSX component or plain markup — plus the JSON metadata sidecar if requested.' },
];

const modeGuide = [
  {
    mode: 'auto',
    assumes: 'General input. Computes dimensions, unique colours (1% noise floor), edge hardness, and ink ratio to select a profile automatically.',
    when: 'Default for initial runs or automated batch pipelines where image types vary.',
    symptom: 'Faint paper grain or scanner tints on ink art can trigger photo or icon mode instead of line-art; anti-aliased icon borders may classify as photo.',
  },
  {
    mode: 'icon',
    assumes: 'Flat fills, few unique colours (≤32 after 1% noise floor), or flat fills over an alpha channel. Runs primitive recognition for <circle>, <ellipse>, and <rect>.',
    when: 'UI icons, vector logos, geometric badges, flat illustrations, and pictograms.',
    symptom: 'Running on photos produces severe posterization and color banding. If photo mode is mistakenly used on an icon, outlines become fuzzy, node counts bloat, and primitive recognition is skipped.',
  },
  {
    mode: 'pixel-art',
    assumes: 'Low resolution (≤128px), ≤64 unique colours, sharp transitions with zero anti-aliasing.',
    when: 'Retro game sprites, pixel icons, 8-bit / 16-bit graphics, and favicon pixel grids.',
    symptom: 'Running on smooth icons or photos produces blocky, jagged pixel staircases. If auto or icon mode is run on pixel art, curve smoothing rounds sharp corners into distorted, pill-shaped blobs.',
  },
  {
    mode: 'line-art',
    assumes: 'Two-tone ink drawing on paper (ink ratio < 25%). Binarizes with Otsu + Sauvola thresholding. Pairs with --stroke for centerline tracing.',
    when: 'Scanned sketches, architectural diagrams, technical schematics, wireframes, and handwritten signatures.',
    symptom: 'Running on multi-colour images triggers duotone validation fallback to k-means or crushes subtle hues into high contrast. Tracing line art with icon mode creates doubled hollow outlines instead of single stroked centerlines.',
  },
  {
    mode: 'photo',
    assumes: 'Continuous-tone imagery, photographic palettes, subtle gradients, and complex real-world textures.',
    when: 'Photographs, paintings, renders with lighting gradients, and complex textured art.',
    symptom: 'Running on icons creates stacked layers with edge slivers and no primitive shapes. Running icon mode on a photo creates harsh color banding across gradual transitions.',
  },
];

const recipes = [
  {
    goal: 'Vectorize a flat corporate logo into a clean 4-colour SVG',
    cmd: 'spryteo convert logo.png -o logo.svg --mode icon --colors 4',
  },
  {
    goal: 'Vectorize an icon with centroid transform origins and bake in a CSS pop animation',
    cmd: 'spryteo convert icon.png -o icon.svg --mode icon --css pop --transform-origin centroid',
  },
  {
    goal: 'Trace a retro pixel-art sprite preserving exact pixel corners without smoothing',
    cmd: 'spryteo convert player.png -o player.svg --mode pixel-art',
  },
  {
    goal: 'Trace an ink drawing or signature into single continuous stroked paths',
    cmd: 'spryteo convert signature.png -o signature.svg --mode line-art --stroke',
  },
  {
    goal: 'Vectorize a photograph into 16 stacked colour layers with gradient detection',
    cmd: 'spryteo convert photo.jpg -o photo.svg --mode photo --colors 16 --layering stacked --gradients auto',
  },
  {
    goal: 'Emit a reusable React JSX component with camelCase attributes',
    cmd: 'spryteo convert badge.png -o Badge.jsx --mode icon --jsx',
  },
  {
    goal: 'Split a raster icon contact sheet into individual SVGs on a 24px canonical grid',
    cmd: 'spryteo sheet sheet.png -o ./icons/ --canonical-size 24 --name-prefix icon',
  },
  {
    goal: 'Vectorize a monochrome glyph inheriting parent CSS color via currentColor',
    cmd: 'spryteo convert glyph.png -o glyph.svg --mode icon --current-color',
  },
  {
    goal: 'Export an SVG with a JSON metadata sidecar for programmatic inspection',
    cmd: 'spryteo convert mark.png -o mark.svg --mode icon --json mark.json',
  },
];

const troubleshooting = [
  {
    symptom: 'Output file size too large / too many nodes',
    cause: 'Curve-fit tolerance is too strict, noise suppression area is too low, or colour count is too high.',
    fix: 'Increase --tolerance (e.g. --tolerance 1.0), increase --turdsize (e.g. --turdsize 8) to drop speckle noise, or reduce --colors.',
  },
  {
    symptom: 'Fine details or small shapes lost as noise',
    cause: 'The --turdsize area threshold exceeds the pixel area of small dots or punctuation, or downscaling discarded them.',
    fix: 'Decrease --turdsize (e.g. --turdsize 1 or --turdsize 0), or increase --max-trace-dimension to prevent downscaling.',
  },
  {
    symptom: 'Logo or line drawing traced as hollow outlines instead of filled shapes or strokes',
    cause: 'Image was traced in default fill mode instead of centerline tracing.',
    fix: 'Pass --stroke (typically with --mode line-art) to run the skeletonizing centerline tracer instead of contour outlining.',
  },
  {
    symptom: 'Colours merged together that should remain distinct',
    cause: '--colors target is too low, or k-means clustering in Lab space merged visually close hues.',
    fix: 'Increase --colors (e.g. --colors 16), or specify exact brand colours with --palette "#hex1,#hex2,#hex3".',
  },
  {
    symptom: 'Slow conversion on a large photograph',
    cause: 'High-resolution images require extensive contour extraction across multiple quantized layers.',
    fix: 'Lower working dimension with --max-trace-dimension 1024 (or 800), use --layering cutout, or lower --colors.',
  },
];

const mcpTools = [
  {
    name: 'convert_image',
    args: 'image_base64 (string, required): Base64-encoded raw image bytes (PNG, JPEG, GIF, WebP, BMP), with or without data:...;base64, prefix. options (object, optional): Partial ConvertOptions JSON object (e.g. {"mode": "icon", "colors": 8, "stroke": true}). Omitted fields fall back to ConvertOptions::default().',
    returns: 'Serialized ConvertResult JSON string containing svg (rendered SVG markup) and meta (metadata sidecar object).',
  },
  {
    name: 'inspect_svg',
    args: 'meta_json (string, required): The serialized meta JSON sidecar string returned by convert_image (not the raw SVG markup).',
    returns: 'Human-readable Markdown inspection summary showing schema version, total node count, path count, byte count, and a table of individual nodes (ID, group, shape, paint, bounding box, centroid, area, outline length, suggested draw order).',
  },
];

const metadataFields: [string, string][] = [
  ['schema_version', 'Metadata schema version (currently 1). Pre-versioning sidecars deserialize as 0.'],
  ['stats.node_count', 'Total number of shape nodes in the scene.'],
  ['stats.path_count', 'Total number of vector paths emitted.'],
  ['stats.byte_count', 'Byte size of the serialized SVG markup.'],
  ['current_color_applied', 'Boolean indicating whether monochrome fill was mapped to fill="currentColor".'],
  ['groups', 'Mirrors the emitted <g> element hierarchy with id, nodes (IDs), and nested groups.'],
  ['nodes[].id', 'Content-derived stable identifier (e.g. s-a1b2c3d4).'],
  ['nodes[].bbox', 'Exact axis-aligned bounding box [x_min, y_min, x_max, y_max].'],
  ['nodes[].centroid', 'Center of mass (cx, cy) computed by Green\'s theorem curve integrals.'],
  ['nodes[].area', 'Surface area in square user units.'],
  ['nodes[].fill', 'Representative sRGB colour {r, g, b} for quick identification.'],
  ['nodes[].paint', 'Lossless paint definition: solid colour, currentColor with fallback, or linear/radial gradient with stops and coordinate vectors.'],
  ['nodes[].stroke', 'Lossless stroke paint and width for centerline paths (null for filled shapes).'],
  ['nodes[].shape', 'Emitted element kind: path, circle, ellipse, rect, or arc.'],
  ['nodes[].closed', 'Whether the outline closes back on itself (false for open centerline strokes).'],
  ['nodes[].path_length', 'Total outline length in user units (normalizes with pathLength="100" in stroke mode).'],
  ['nodes[].group', 'ID of the immediate parent <g> element.'],
  ['nodes[].group_path', 'Ancestor group IDs from root down to immediate parent.'],
  ['nodes[].z_order', 'Paint order index (0 = bottom layer, painted first).'],
  ['nodes[].suggested_draw_order', 'Reveal sequence index for entrance animations (ranks nesting depth first, descending area second).'],
];
