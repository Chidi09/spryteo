<script>
  // Scroll-spy: highlight the TOC link for whichever section heading is
  // currently in view.
  const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc-link'));
  const sections = tocLinks
    .map((link) => document.getElementById(link.getAttribute('href')!.slice(1)))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length && 'IntersectionObserver' in window) {
    const setActive = (id: string) => {
      tocLinks.forEach((link) => {
        link.classList.toggle('active', link.getAttribute('href') === '#' + id);
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible.length > 0) setActive(visible[0].target.id);
      },
      { rootMargin: '-90px 0px -70% 0px', threshold: 0 }
    );
    sections.forEach((el) => observer.observe(el));
  }

  // AI conveniences: copy the plain-markdown mirror of this page straight
  // to the clipboard, for pasting into an LLM chat without a round-trip
  // through the browser's downloads folder.
  const copyBtn = document.getElementById('copyMd');
  copyBtn?.addEventListener('click', async () => {
    const label = copyBtn.querySelector('.ai-btn-icon');
    const originalIconHtml = label?.innerHTML ?? '';
    try {
      const res = await fetch('/docs.md');
      const text = await res.text();
      await navigator.clipboard.writeText(text);
      copyBtn.classList.add('ai-btn-done');
      if (label) label.textContent = '✓';
      setTimeout(() => {
        copyBtn.classList.remove('ai-btn-done');
        if (label) label.innerHTML = originalIconHtml;
      }, 1800);
    } catch {
      // Clipboard API unavailable/denied -- fall back to just opening the file.
      window.open('/docs.md', '_blank');
    }
  });
</script>

