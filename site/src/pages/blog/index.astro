---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { blog } from '../../lib/seo';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const title = 'Blog — Spryteo';
const description =
  'Notes on raster-to-SVG vectorization, structured and animateable output, determinism, and the ideas behind Spryteo.';

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base
  title={title}
  description={description}
  crumbs={[{ name: 'Spryteo', path: '/' }, { name: 'Blog', path: '/blog' }]}
  jsonLd={[blog(posts.map((p) => ({ path: `/blog/${p.id}`, headline: p.data.title })))]}
>
  <Header />
  <main class="wrap">
    <header class="head">
      <p class="eyebrow">writing</p>
      <h1>Notes on vectorization</h1>
      <p class="lede">{description}</p>
    </header>

    {posts.length === 0 && <p class="empty">Nothing published yet.</p>}

    <ul class="posts">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}`}>
            <span class="topic">{post.data.topic}</span>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
          </a>
        </li>
      ))}
    </ul>
  </main>
  <Footer />
</Base>

<style>
  .wrap { max-width: 820px; margin: 0 auto; padding: 96px 24px 120px; flex: 1; }
  .head { margin-bottom: 64px; }
  .eyebrow {
    color: var(--accent); font-family: var(--font-mono); font-size: 13px;
    letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 16px;
  }
  h1 { font-size: clamp(32px, 5vw, 48px); letter-spacing: -0.03em; margin: 0 0 16px; }
  .lede { color: var(--muted); font-size: 18px; line-height: 1.6; margin: 0; max-width: 62ch; }
  .empty { color: var(--muted); }
  .posts { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .posts a {
    display: block; padding: 28px 0; border-top: 1px solid var(--border);
    color: inherit; text-decoration: none;
  }
  .posts a:hover h2 { color: var(--accent); }
  .topic {
    color: var(--muted); font-family: var(--font-mono); font-size: 12px;
    letter-spacing: 0.08em; text-transform: uppercase;
  }
  .posts h2 {
    font-size: 24px; letter-spacing: -0.02em; margin: 10px 0 8px;
    transition: color 120ms ease;
  }
  .posts p { color: var(--muted); line-height: 1.6; margin: 0 0 12px; max-width: 62ch; }
  time { color: var(--muted); font-family: var(--font-mono); font-size: 13px; }
</style>
