---
import Base from '../layouts/Base.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SheetDemo from '../components/sections/SheetDemo.astro';
---

<Base
  title="Sheet mode — Spryteo"
  description="Drop an icon contact sheet. Every icon comes back as its own animateable SVG — entirely offline."
  crumbs={[{ name: 'Spryteo', path: '/' }, { name: 'Sheet mode', path: '/sheet' }]}
>
  <Header />

  <main class="sheet-page">
    <div class="sheet-hero">
      <h1 class="sheet-title sc-stagger">Sheet mode</h1>
      <p class="sheet-lead sc-stagger">
        Drop an icon contact sheet. Every icon comes back as its own animateable SVG &#8212; entirely offline.
      </p>
    </div>

    <SheetDemo />

    <div class="how-it-works-row sc-stagger">
      <span class="row-label">how it works:</span>
      <div class="row-steps">
        <span class="step-chip">segmentation</span>
        <span class="step-arrow">&#8594;</span>
        <span class="step-chip">lattice</span>
        <span class="step-arrow">&#8594;</span>
        <span class="step-chip">per-icon trace</span>
        <span class="step-arrow">&#8594;</span>
        <span class="step-chip">width unification</span>
      </div>
    </div>
  </main>

  <Footer />
</Base>

<style>
  .sheet-page {
    flex: 1;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 60px 32px 80px;
  }
  .sheet-hero {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 40px;
  }
  .sheet-title {
    font-size: 48px;
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0 0 16px;
  }
  .sheet-lead {
    font-size: 18px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0;
    text-wrap: pretty;
  }
  .how-it-works-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-top: 48px;
    padding: 16px 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    flex-wrap: wrap;
  }
  .row-label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
  .row-steps {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .step-chip {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    background: rgba(198, 255, 75, 0.08);
    border: 1px solid rgba(198, 255, 75, 0.22);
    border-radius: 4px;
    padding: 4px 10px;
  }
  .step-arrow {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  @media (max-width: 768px) {
    .sheet-page {
      padding: 40px 20px 60px;
    }
    .sheet-title {
      font-size: 36px;
    }
    .sheet-lead {
      font-size: 16px;
    }
    .how-it-works-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }
</style>
